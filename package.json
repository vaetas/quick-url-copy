{
  "name": "quick-url-copy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint:firefox": "bun run build:firefox && web-ext lint",
    "sign:firefox": "bun run build:firefox && bun --env-file=.env run sign:firefox:amo",
    "sign:firefox:amo": "web-ext sign",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.20.6"
  }
}
